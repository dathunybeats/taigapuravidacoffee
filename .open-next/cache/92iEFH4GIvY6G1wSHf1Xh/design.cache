ida Coffee\"/><meta property=\"og:description\" content=\"Specialty coffee rooted in Costa Rican heritage. Small-batch, ethically sourced, brewed with love.\"/><meta property=\"og:image\" content=\"http://localhost:3000/logo-square-brown.png\"/><meta property=\"og:image:width\" content=\"1080\"/><meta property=\"og:image:height\" content=\"1080\"/><meta property=\"og:image:alt\" content=\"Taïga Pura Vida Coffee\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"Taïga Pura Vida Coffee\"/><meta name=\"twitter:description\" content=\"Specialty coffee rooted in Costa Rican heritage. Small-batch, ethically sourced, brewed with love.\"/><meta name=\"twitter:image\" content=\"http://localhost:3000/logo-square-brown.png\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.0zsak4he6hz_d.ico\" sizes=\"1200x716\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/logo-mark-amber.png\"/><link rel=\"apple-touch-icon\" href=\"/logo-mark-amber.png\"/><script src=\"/_next/static/chunks/03~yq9q893hmn.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"min-h-screen bg-[#FAF6F0] font-sans\"><header class=\"bg-[#2B1608] px-5 sm:px-12 py-5 sm:py-8 flex items-center justify-between\"><div class=\"flex items-center gap-3 sm:gap-6\"><img src=\"/logo.png\" alt=\"Taïga Pura Vida Coffee\" class=\"h-10 w-10 sm:h-16 sm:w-16 object-contain brightness-0 invert opacity-90\"/><div><p class=\"text-[#C4622D] text-[10px] sm:text-xs tracking-[0.3em] uppercase mb-0.5 sm:mb-1\">Design Deck</p><h1 class=\"text-[#EDD9B8] text-base sm:text-2xl font-light tracking-widest uppercase\">Taïga Pura Vida Coffee</h1></div></div><p class=\"text-[#EDD9B8]/40 text-xs sm:text-sm tracking-widest hidden sm:block\">v1.0</p></header><main class=\"max-w-6xl mx-auto px-4 sm:px-8 py-10 sm:py-16 space-y-16 sm:space-y-24 page-enter\"><div class=\"reveal \"><section><div class=\"flex items-center gap-4\"><p class=\"text-[#2B1608] text-lg sm:text-xl font-medium tracking-tight shrink-0\">01 — Brand Essence</p><div class=\"flex-1 h-px bg-[#EDD9B8]\"></div></div><p class=\"text-[#C4622D] text-xs tracking-[0.3em] uppercase mt-8 mb-4\">Lockups</p><div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4\"><div class=\"bg-[#FAF6F0] border border-[#EDD9B8]/60 rounded-2xl p-6 sm:p-8 flex flex-col gap-3\"><span class=\"text-[#2B1608]/40 text-[10px] tracking-[0.25em] uppercase\">Square · Brown</span><img src=\"/logo-square-brown.png\" alt=\"Square brown lockup\" class=\"w-full object-contain\"/></div><div class=\"bg-[#FAF6F0] border border-[#EDD9B8]/60 rounded-2xl p-6 sm:p-8 flex flex-col gap-3\"><span class=\"text-[#2B1608]/40 text-[10px] tracking-[0.25em] uppercase\">Square · Amber</span><img src=\"/logo-square-amber.png\" alt=\"Square amber lockup\" class=\"w-full object-contain\"/></div><div class=\"bg-[#FAF6F0] border border-[#EDD9B8]/60 rounded-2xl p-6 sm:p-8 flex flex-col gap-3\"><span class=\"text-[#2B1608]/40 text-[10px] tracking-[0.25em] uppercase\">Square · Inverted</span><div class=\"bg-[#2B1608] rounded-xl p-4 flex items-center justify-center\"><img src=\"/logo-square-brown.png\" alt=\"Square inverted lockup\" class=\"w-full object-contain brightness-0 invert\"/></div></div></div><div class=\"mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4\"><div class=\"bg-[#FAF6F0] border border-[#EDD9B8]/60 rounded-2xl p-6 sm:p-8 flex flex-col gap-3\"><span class=\"text-[#2B1608]/40 text-[10px] tracking-[0.25em] uppercase\">Horizontal lockup</span><img src=\"/logo-horizontal.png\" alt=\"Horizontal lockup\" class=\"w-full object-contain\"/></div><div class=\"bg-[#2B1608] rounded-2xl p-6 sm:p-8 flex flex-col gap-3\"><span class=\"text-[#EDD9B8]/40 text-[10px] tracking-[0.25em] uppercase\">Horizontal · Dark bg</span><img src=\"/logo-horizontal.png\" alt=\"Horizontal lockup dark\" class=\"w-full object-contain brightness-0 invert\"/></div></div><div class=\"mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4\"><div class=\"bg-[#FAF6F0] border border-[#EDD9B8]/60 rounded-2xl p-6 sm:p-8 flex flex-col gap-3\"><span class=\"text-[#2B1608]/40 text-[10px] tracking-[0.25em] uppercase\">Wordmark</span><img src=\"/logo-wordmark.png\" alt=\"Wordmark\" class=\"w-full object-contain\"/></div><div class=\"bg-[#2B1608] rounded-2xl p-6 sm:p-8 flex flex-col gap-3\"><span class=\"text-[#EDD9B8]/40 text-[10px] tracking-[0.25em] uppercase\">Wordmark · Dark bg</span><img src=\"/logo-wordmark.png\" alt=\"Wordmark dark\" class=\"w-full object-contain brightness-0 invert\"/></div></div><p class=\"text-[#C4622D] text-xs tracking-[0.3em] uppercase mt-8 mb-4\">Jaguar mark — standalone</p><div class=\"grid grid-cols-2 sm:grid-cols-4 gap-4\"><div class=\"bg-[#FAF6F0] border border-[#EDD9B8]/60 rounded-2xl p-4 sm:p-6 flex flex-col items-center gap-3\"><span class=\"text-[#2B1608]/40 text-[10px] tracking-[0.25em] uppercase\">Black</span><img src=\"/logo-mark-black.png\" alt=\"Jaguar mark black\" class=\"w-20 h-16 sm:w-32 sm:h-24 object-contain\"/></div><div class=\"bg-[#FAF6F0] border border-[#EDD9B8]/60 rounded-2xl p-4 sm:p-6 flex flex-col items-center gap-3\"><span class=\"text-[#2B1608]/40 text-[10px] tracking-[0.25em] uppercase\">Amber</span><img src=\"/logo-mark-amber.png\" alt=\"Jaguar mark amber\" class=\"w-20 h-16 sm:w-32 sm:h-24 object-contain\"/></div><div class=\"bg-[#FAF6F0] border border-[#EDD9B8]/60 rounded-2xl p-4 sm:p-6 flex flex-col items-center gap-3\"><span class=\"text-[#2B1608]/40 text-[10px] tracking-[0.25em] uppercase\">Cream</span><img src=\"/logo-mark-cream.png\" alt=\"Jaguar mark cream\" class=\"w-20 h-16 sm:w-32 sm:h-24 object-contain\"/></div><div class=\"bg-[#2B1608] rounded-2xl p-4 sm:p-6 flex flex-col items-center gap-3\"><span class=\"text-[#EDD9B8]/40 text-[10px] tracking-[0.25em] uppercase\">White</span><img src=\"/logo-mark-black.png\" alt=\"Jaguar mark white\" class=\"w-20 h-16 sm:w-32 sm:h-24 object-contain brightness-0 invert\"/></div></div><div class=\"grid grid-cols-1 sm:grid-cols-3 gap-6 mt-8\"><div class=\"bg-[#2B1608] rounded-2xl p-6 sm:p-8\"><h3 class=\"text-[#C4622D] text-xs tracking-[0.3em] uppercase mb-3\">Wild</h3><p class=\"text-[#EDD9B8]/70 text-sm leading-6 font-light\">The jaguar. Untamed, proud, rooted in the forest. The brand carries nature&#x27;s quiet confidence.</p></div><div class=\"bg-[#2B1608] rounded-2xl p-6 sm:p-8\"><h3 class=\"text-[#C4622D] text-xs tracking-[0.3em] uppercase mb-3\">Warm</h3><p class=\"text-[#EDD9B8]/70 text-sm leading-6 font-light\">Cocoa tones, amber light, the smell of fresh roast. Every touchpoint should feel like a warm welcome.</p></div><div class=\"bg-[#2B1608] rounded-2xl p-6 sm:p-8\"><h3 class=\"text-[#C4622D] text-xs tracking-[0.3em] uppercase mb-3\">Pura Vida</h3><p class=\"text-[#EDD9B8]/70 text-sm leading-6 font-light\">Costa Rican for &#x27;pure life.&#x27; Unhurried, joyful, authentic. Not just coffee — a way of being.</p></div></div></section></div><div class=\"reveal \"><section><div class=\"flex items-center gap-4\"><p class=\"text-[#2B1608] text-lg sm:text-xl font-medium tracking-tight shrink-0\">02 — Color Palette</p><div class=\"flex-1 h-px bg-[#EDD9B8]\"></div></div><div class=\"grid grid-cols-2 gap-4 mt-8 sm:grid-cols-5\"><div class=\"rounded-2xl overflow-hidden \"><div class=\"h-20 sm:h-28\" style=\"background-color:#2B1608\"></div><div class=\"bg-white border-x border-b border-[#EDD9B8]/40 rounded-b-2xl p-3 sm:p-4\"><p class=\"text-sm font-medium text-[#2B1608]\">Espresso</p><p class=\"text-[#5C2D0E]/50 text-xs mt-0.5 font-mono\">#2B1608</p><p class=\"text-[#C4622D] text-[10px] tracking-[0.2em] uppercase mt-1\">Primary</p></div></div><div class=\"rounded-2xl overflow-hidden \"><div class=\"h-20 sm:h-28\" style=\"background-color:#5C2D0E\"></div><div class=\"bg-white border-x border-b border-[#EDD9B8]/40 rounded-b-2xl p-3 sm:p-4\"><p class=\"text-sm font-medium text-[#2B1608]\">Dark Roast</p><p class=\"text-[#5C2D0E]/50 text-xs mt-0.5 font-mono\">#5C2D0E</p><p class=\"text-[#C4622D] text-[10px] tracking-[0.2em] uppercase mt-1\">Secondary</p></div></div><div class=\"rounded-2xl overflow-hidden \"><div class=\"h-20 sm:h-28\" style=\"background-color:#C4622D\"></div><div class=\"bg-white border-x border-b border-[#EDD9B8]/40 rounded-b-2xl p-3 sm:p-4\"><p class=\"text-sm font-medium text-[#2B1608]\">Amber</p><p class=\"text-[#5C2D0E]/50 text-xs mt-0.5 font-mono\">#C4622D</p><p class=\"text-[#C4622D] text-[10px] tracking-[0.2em] uppercase mt-1\">Accent</p></div></div><div class=\"rounded-2xl overflow-hidden \"><div class=\"h-20 sm:h-28\" style=\"background-color:#EDD9B8\"></div><div class=\"bg-white border-x border-b border-[#EDD9B8]/40 rounded-b-2xl p-3 sm:p-4\"><p class=\"text-sm font-medium text-[#2B1608]\">Cream</p><p class=\"text-[#5C2D0E]/50 text-xs mt-0.5 font-mono\">#EDD9B8</p><p class=\"text-[#C4622D] text-[10px] tracking-[0.2em] uppercase mt-1\">Highlight</p></div></div><div class=\"rounded-2xl overflow-hidden border border-[#EDD9B8]\"><div class=\"h-20 sm:h-28\" style=\"background-color:#FAF6F0\"></div><div class=\"bg-white border-x border-b border-[#EDD9B8]/40 rounded-b-2xl p-3 sm:p-4\"><p class=\"text-sm font-medium text-[#2B1608]\">Linen</p><p class=\"text-[#5C2D0E]/50 text-xs mt-0.5 font-mono\">#FAF6F0</p><p class=\"text-[#C4622D] text-[10px] tracking-[0.2em] uppercase mt-1\">Background</p></div></div></div></section></div><div class=\"reveal \"><section><div class=\"flex items-center gap-4\"><p class=\"text-[#2B1608] text-lg sm:text-xl font-medium tracking-tight shrink-0\">03 — Typography</p><div class=\"flex-1 h-px bg-[#EDD9B8]\"></div></div><div class=\"mt-8 bg-white rounded-2xl p-6 sm:p-10 border border-[#EDD9B8]/60 space-y-8 sm:space-y-10\"><div><p class=\"text-[#C4622D] text-xs tracking-[0.25em] uppercase mb-3\">Display — El Hidrant · Headline</p><h1 class=\"text-[#2B1608] leading-none text-5xl sm:text-7xl\">Pure Life.<br/>Perfect Cup.</h1></div><div><p class=\"text-[#C4622D] text-xs tracking-[0.25em] uppercase mb-3\">Heading — El Hidrant · H2</p><h2 class=\"text-[#2B1608] text-3xl sm:text-4xl\">Sourced from the heart of Costa Rica</h2></div><div><p class=\"text-[#C4622D] text-xs tracking-[0.25em] uppercase mb-3\">Subheading — El Hidrant · H3</p><h3 class=\"text-[#2B1608] text-xl sm:text-2xl\">Small batch. Big flavour.</h3></div><div><p class=\"text-[#C4622D] text-xs tracking-[0.25em] uppercase mb-3\">Body — GT Flexa Light · 300 · 1.6 line-height</p><p class=\"text-[#5C2D0E]/70 text-base leading-7\" style=\"font-family:var(--font-base);font-weight:400\">Every batch is small-roasted to order, honouring the farmers and the land that made it possible. No shortcuts. No compromises.</p></div><div><p class=\"text-[#C4622D] text-xs tracking-[0.25em] uppercase mb-3\">Label / Caption — GT Flexa Light · 0.3em tracking</p><p class=\"text-[#2B1608] text-xs tracking-[0.3em] uppercase\" style=\"font-family:var(--font-base);font-weight:500\">Single Origin · Washed Process · Light Roast</p></div></div></section></div><div class=\"reveal \"><section><div class=\"flex items-center gap-4\"><p class=\"text-[#2B1608] text-lg sm:text-xl font-medium tracking-tight shrink-0\">04 — UI Components</p><div class=\"flex-1 h-px bg-[#EDD9B8]\"></div></div><div class=\"mt-8 space-y-6\"><div class=\"bg-white rounded-2xl p-6 sm:p-10 border border-[#EDD9B8]/60\"><p class=\"text-[#C4622D] text-xs tracking-[0.25em] uppercase mb-6 sm:mb-8\">Buttons</p><div class=\"flex flex-wrap gap-3 sm:gap-4 items-center\"><button class=\"bg-[#2B1608] text-[#EDD9B8] px-6 sm:px-8 py-3 sm:py-3.5 rounded-full sweep-btn\" style=\"font-family:var(--font-button);font-weight:700;font-size:var(--font-button-size);text-transform:uppercase;letter-spacing:var(--font-button-letter-spacing);--sweep-bg:#5C2D0E\">Order Now</button><button class=\"bg-[#C4622D] text-white px-6 sm:px-8 py-3 sm:py-3.5 rounded-full sweep-btn\" style=\"font-family:var(--font-button);font-weight:700;font-size:var(--font-button-size);text-transform:uppercase;le